Package: correlationr
Type: Package
Title: Conduct Robust Correlations on Non-Normal Data
Version: 0.1.0
Authors@R: c(
    person("Johnson", "Li", email = "johnson.li@umanitoba.ca", role = "aut", comment = c(ORCID = "")),
